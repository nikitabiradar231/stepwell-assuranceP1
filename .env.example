# Stepwell Assurance Deployment Environment Variables (Template)
# Copy this file to .env and configure your values. NEVER commit your actual .env file!

# Ethereum Sepolia RPC URL (e.g., Alchemy, Infura, or public Sepolia RPC)
SEPOLIA_RPC_URL=YOUR_SEPOLIA_RPC_URL

# Testnet Deployer Private Key (Do NOT use a mainnet key or commit this)
PRIVATE_KEY=YOUR_TESTNET_PRIVATE_KEY

# Optional: Etherscan API Key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Campaign Configuration Parameters
# Target in wei (e.g., 0.1 ETH = 100000000000000000 wei)
CAMPAIGN_TARGET_WEI=100000000000000000

# Campaign Deadline Unix timestamp (must be in the future)
CAMPAIGN_DEADLINE=1794000000

# Designated beneficiary address authorized to collect funds upon success
CAMPAIGN_BENEFICIARY=YOUR_BENEFICIARY_ADDRESS
